---
import { withBase } from '../utils/url.js';
import { services as capabilities } from '../data/services.js';

/**
 * The brief, laid out as a ruled index like the projects list: each step
 * carries its number and name on the left and its fields on the right, so the
 * form reads as four short questions instead of one long sheet.
 *
 * Choices are real radio inputs under custom tiles, so keyboard and screen
 * reader behaviour stays native. The submit handler in main.js reads fields by
 * id and chips through their `[data-i18n]` label, so both have to survive any restyle.
 */
// The service choices are the capabilities themselves, so the form never
// offers something the Services section does not.
const services = capabilities.map((c) => ({
    value: c.title, key: `srv.${c.id}.title`, label: c.title, icon: c.icon,
}));

// Labels are the ES (COP) ones; the EN dictionary quotes the same ranges in USD.
const budgets = [
    { value: '200k-400k', key: 'contact.budget.opt1', label: '200.000 COP - 400.000 COP' },
    { value: '400k-800k', key: 'contact.budget.opt2', label: '400.000 COP - 800.000 COP' },
    { value: '800k-1m', key: 'contact.budget.opt3', label: '800.000 COP - 1.000.000 COP' },
    { value: '1m+', key: 'contact.budget.opt4', label: '>1.000.000 COP' },
];

// Platforms carry their own glyph, inlined from Simple Icons (simpleicons.org,
// CC0) so it takes the chip's colour like the Lucide ones. Lucide dropped its
// brand icons; the two that are not platforms use Lucide.
const sources = [
    {
        value: 'Instagram', key: 'contact.source.opt1', label: 'Instagram',
        brand: 'M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077'
    },
    {
        value: 'YouTube', key: 'contact.source.opt2', label: 'YouTube',
        brand: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'
    },
    {
        value: 'Google', key: 'contact.source.opt3', label: 'Google',
        brand: 'M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z'
    },
    { value: 'Anuncio', key: 'contact.source.opt4', label: 'Anuncio', icon: 'megaphone' },
    { value: 'Referencia', key: 'contact.source.opt5', label: 'Referencia', icon: 'users' },
];
---
<section class="contact" id="contact">
    <div class="container">
        <div class="contact-card reveal">
            <header class="contact-head">
                <span class="contact-eyebrow" data-i18n="contact.label">[ Consultas ]</span>
                <h2 class="gradient-text" data-motion="heading" data-i18n="contact.title">Construyamos algo.</h2>
                <p data-motion="words" data-i18n="contact.subtitle">Cuéntanos tu proyecto y te respondemos por correo.</p>
            </header>

            <form id="contactForm" class="brief">
                <!-- Web3Forms honeypot: hidden from people, filled by bots, and
                     any submission that carries it is dropped as spam. -->
                <input type="checkbox" name="botcheck" class="brief-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
                <div class="brief-step">
                    <div class="brief-step__meta" aria-hidden="true">
                        <span class="brief-step__num">01</span>
                        <span class="brief-step__name" data-i18n="contact.step.service">Servicio</span>
                    </div>
                    <div class="brief-step__body">
                        <p class="brief-label" id="briefService">
                            <span data-i18n="contact.service">¿Qué servicio te interesa?</span><span class="req" aria-hidden="true">*</span>
                        </p>
                        <!-- On phones the seven tiles fold into a dropdown: the
                             trigger shows the current pick and opens the same
                             tiles below it. On desktop the trigger is hidden
                             and the grid always shows. -->
                        <div class="choice-drop" data-choice-drop>
                            <button type="button" class="choice-drop__trigger radio-chip" aria-expanded="false" aria-controls="briefServiceGrid">
                                <span class="radio-chip__icon" aria-hidden="true" data-choice-drop-icon><i data-lucide="layout-grid"></i></span>
                                <span class="choice-drop__value" data-choice-drop-value data-i18n="contact.service.pick">Elige un servicio</span>
                                <span class="choice-drop__chev" aria-hidden="true"><i data-lucide="chevron-down"></i></span>
                            </button>
                            <div class="choice-grid choice-grid--3 choice-drop__panel" id="briefServiceGrid" role="radiogroup" aria-labelledby="briefService">
                                {services.map((s, i) => (
                                    <label class="radio-chip">
                                        <input type="radio" name="service" value={s.value} required={i === 0}>
                                        <span class="radio-chip__icon" aria-hidden="true"><i data-lucide={s.icon}></i></span>
                                        <span data-i18n={s.key}>{s.label}</span>
                                        <span class="radio-chip__dot" aria-hidden="true"></span>
                                    </label>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="brief-step">
                    <div class="brief-step__meta" aria-hidden="true">
                        <span class="brief-step__num">02</span>
                        <span class="brief-step__name" data-i18n="contact.step.budget">Inversión</span>
                    </div>
                    <div class="brief-step__body">
                        <p class="brief-label" id="briefBudget">
                            <span data-i18n="contact.budget">Presupuesto mensual</span><span class="req" aria-hidden="true">*</span>
                        </p>
                        <div class="choice-grid choice-grid--2" role="radiogroup" aria-labelledby="briefBudget">
                            {budgets.map((b, i) => (
                                <label class="radio-chip">
                                    <input type="radio" name="budget" value={b.value} required={i === 0}>
                                    <span data-i18n={b.key}>{b.label}</span>
                                    <span class="radio-chip__dot" aria-hidden="true"></span>
                                </label>
                            ))}
                        </div>
                    </div>
                </div>

                <div class="brief-step" role="group" aria-labelledby="briefDetails">
                    <div class="brief-step__meta">
                        <span class="brief-step__num" aria-hidden="true">03</span>
                        <span class="brief-step__name" id="briefDetails" data-i18n="contact.step.details">Tus datos</span>
                    </div>
                    <div class="brief-step__body brief-fields">
                        <div class="field">
                            <label for="name" class="brief-label">
                                <span data-i18n="contact.name">Nombre</span><span class="req" aria-hidden="true">*</span>
                            </label>
                            <input type="text" id="name" name="name" class="field__input" autocomplete="name" placeholder="Ej. Juan Pérez" data-i18n-placeholder="contact.name.placeholder" required>
                        </div>
                        <div class="field">
                            <label for="company" class="brief-label" data-i18n="contact.company">Compañía</label>
                            <input type="text" id="company" name="company" class="field__input" autocomplete="organization" placeholder="Ej. Acme Corp" data-i18n-placeholder="contact.company.placeholder">
                        </div>
                        <div class="field">
                            <label for="email" class="brief-label">
                                <span data-i18n="contact.email">Correo</span><span class="req" aria-hidden="true">*</span>
                            </label>
                            <input type="email" id="email" name="email" class="field__input" autocomplete="email" placeholder="juan@ejemplo.com" data-i18n-placeholder="contact.email.placeholder" required>
                        </div>
                        <div class="field">
                            <label for="phone" class="brief-label">
                                <span data-i18n="contact.phone">Teléfono</span><span class="req" aria-hidden="true">*</span>
                            </label>
                            <div class="field__affix">
                                <span class="field__prefix" aria-hidden="true">+57</span>
                                <input type="tel" id="phone" name="phone" class="field__input" autocomplete="tel-national" inputmode="numeric" placeholder="3211234567" pattern="^3[0-9]{9}$" title="El teléfono debe tener 10 dígitos y empezar por 3" data-i18n-title="contact.phone.title" maxlength="10" minlength="10" required>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="brief-step" role="group" aria-labelledby="briefProject">
                    <div class="brief-step__meta">
                        <span class="brief-step__num" aria-hidden="true">04</span>
                        <span class="brief-step__name" id="briefProject" data-i18n="contact.step.project">Proyecto</span>
                    </div>
                    <div class="brief-step__body brief-fields">
                        <div class="field field--full">
                            <label for="project" class="brief-label" data-i18n="contact.project">Cuéntanos sobre tu proyecto</label>
                            <textarea id="project" name="project" class="field__input field__input--area" rows="4" placeholder="Describe brevemente lo que quieres construir..." data-i18n-placeholder="contact.project.placeholder"></textarea>
                        </div>
                        <div class="field field--full">
                            <p class="brief-label" id="briefSource" data-i18n="contact.source">¿Dónde escuchaste sobre nosotros?</p>
                            <div class="choice-grid choice-grid--3 choice-grid--source" role="radiogroup" aria-labelledby="briefSource">
                                {sources.map((s) => (
                                    <label class="radio-chip">
                                        <input type="radio" name="source" value={s.value}>
                                        <span class="radio-chip__icon" aria-hidden="true">
                                            {s.brand
                                                ? <svg viewBox="0 0 24 24" fill="currentColor"><path d={s.brand} /></svg>
                                                : <i data-lucide={s.icon}></i>}
                                        </span>
                                        <span data-i18n={s.key}>{s.label}</span>
                                        <span class="radio-chip__dot" aria-hidden="true"></span>
                                    </label>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="brief-footer">
                    <label class="checkbox-label">
                        <input type="checkbox" name="terms" required>
                        <span class="checkbox-label__box" aria-hidden="true"><i data-lucide="check"></i></span>
                        <span><span data-i18n="contact.terms">He leído y acepto la</span> <a href={withBase('/politica-de-datos/')} target="_blank" rel="noopener" data-i18n="contact.terms.link">Política de Tratamiento de Datos Personales</a>.</span>
                    </label>

                    <div class="brief-submit">
                        <button type="submit" class="btn btn-primary ripple form-submit">
                            <span data-i18n="contact.submit">Enviar mensaje</span>
                            <i data-lucide="arrow-up-right"></i>
                        </button>
                        <p class="brief-submit__note" data-i18n="contact.submit.note">Te responderemos al correo que nos indiques.</p>
                        <p class="brief-submit__status" role="status" aria-live="polite" hidden></p>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
