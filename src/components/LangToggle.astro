---
/**
 * Locale switch, written as language + currency ("ES - COP", "US - USD")
 * because the language also decides the currency the brief's budgets are
 * quoted in. Rendered twice — once inside the mobile menu, once in the
 * desktop nav — and both instances are wired by the I18n module, which keys
 * off .lang-btn[data-lang].
 */
const { class: className = '' } = Astro.props;
---
<div class:list={['lang-toggle', className]}>
    <button class="lang-btn active" data-lang="es" data-i18n-aria="lang.es" aria-label="Español, pesos colombianos (COP)" title="Español · COP" tabindex="0">
        <span class="lang-btn__code">ES</span><span class="lang-btn__sep" aria-hidden="true">-</span><span class="lang-btn__cur">COP</span>
    </button>
    <button class="lang-btn" data-lang="en" data-i18n-aria="lang.en" aria-label="English, US dollars (USD)" title="English · USD" tabindex="0">
        <span class="lang-btn__code">US</span><span class="lang-btn__sep" aria-hidden="true">-</span><span class="lang-btn__cur">USD</span>
    </button>
</div>
