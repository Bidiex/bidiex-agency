---
import { stack } from '../data/stack.js';

/**
 * The stack reads as a typographic index rather than a grid of eight identical
 * cards: the page already spends a bento grid on Services and a carousel on
 * Projects, so a third card layout would blur all three together. A ruled list
 * is also the honest shape for this content — it is a reference table, and it
 * lets each row carry its brand colour on hover without eight competing boxes.
 */
---
<section class="stack" id="stack">
  <div class="container">

    <div class="stack-header reveal">
      <h2 class="section-title gradient-text" data-i18n="stack.title">
        Construido con las<br>herramientas correctas
      </h2>
      <p class="stack-subtitle" data-i18n="stack.subtitle">
        Cada proyecto se desarrolla sobre una base tecnológica
        moderna, escalable y probada en producción.
      </p>
    </div>

    <div class="stack-index reveal">
      {stack.map((tech, i) => (
        <article class="stack-row" style={`--brand-color: ${tech.brand};`}>
          <span class="stack-row__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="stack-row__icon">
            <img class="icon-white" src={`https://cdn.simpleicons.org/${tech.slug}/white`}
                 width="24" height="24" alt={tech.name} loading="lazy">
            <img class="icon-color" src={`https://cdn.simpleicons.org/${tech.slug}`}
                 width="24" height="24" alt="" loading="lazy">
          </span>
          <h3 class="stack-row__name">{tech.name}</h3>
          <p class="stack-row__desc" data-i18n={tech.descKey}>
            {tech.desc}
          </p>
        </article>
      ))}
    </div>

  </div>
</section>
