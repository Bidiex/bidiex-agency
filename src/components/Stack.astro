---
import { stack, iconUrl } from '../data/stack.js';

/**
 * The stack as a band that never stops moving, straight under the hero: it is
 * a credential, not a reference table, so it reads at a glance and gets out of
 * the way.
 *
 * The list is rendered twice inside one track and the track slides by exactly
 * half its width, so the second copy lands where the first began and the loop
 * has no seam. Only the first copy is exposed to assistive technology. The
 * band deliberately does not pause on hover; it only stands still when the
 * visitor has asked the OS for reduced motion.
 */
const copies = [false, true];
---
<section class="tech-band" id="stack" aria-labelledby="stackTitle">
  <div class="container">
    <h2 class="tech-band__title" id="stackTitle" data-motion="heading" data-i18n="stack.title">
      Construido con las herramientas correctas
    </h2>
  </div>

  <div class="tech-band__viewport">
    <div class="tech-band__track">
      {copies.map((isClone) => (
        <ul class="tech-band__list" aria-hidden={isClone ? 'true' : undefined}>
          {stack.map((tech) => (
            <li class="tech-band__item" style={`--brand-color: ${tech.brand};`}>
              <img src={iconUrl(tech)}
                   width="28" height="28" alt="" decoding="async">
              <span>{tech.name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
