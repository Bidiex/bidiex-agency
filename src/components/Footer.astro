---
import { withBase } from '../utils/url.js';
---
<footer class="footer">
    <div class="container footer-content">
        <div class="footer-brand">
            <img class="footer-logo" src={withBase('bidiex-logo.webp')} alt="Bidiex" width="1485" height="420" loading="lazy">
            <span class="footer-tag" data-i18n="footer.tag">Agencia Digital</span>
        </div>
        <div class="footer-links">
            <a href="#contact" data-i18n="footer.contact">Contacto</a>
            <span class="dot">·</span>
            <a href="mailto:soportebidiex@gmail.com">soportebidiex@gmail.com</a>
            <span class="dot">·</span>
            <a href={withBase('/politica-de-datos/')} data-i18n="footer.privacy">Política de Privacidad</a>
        </div>
        <div class="footer-copyright">
            <p>&copy; <span id="currentYear"></span> Bidiex. <span data-i18n="footer.rights">Todos los derechos reservados.</span></p>
        </div>
    </div>
</footer>
