---
import { services } from '../data/services.js';
import { withBase } from '../utils/url.js';
import { visuals } from './motion/index.js';
---
<section class="services" id="services">
    <div class="container">
        <h2 class="section-title gradient-text" data-motion="heading" data-i18n="services.title">Nuestras Capacidades</h2>

        <div class="bento-grid">
            {services.map((service) => {
                const Visual = visuals[service.id];
                return (
                    <div class={`bento-card bento-span-${service.span} reveal card-hover`} id={`card-${service.id}`}>
                        <div class="bento-header">
                            <div class="bento-icon"><i data-lucide={service.icon}></i></div>
                            <h3 class="bento-title" data-i18n={`srv.${service.id}.title`}>{service.title}</h3>
                        </div>
                        <p class="bento-desc" data-i18n={`srv.${service.id}.desc`}>{service.desc}</p>
                        {/* Icon-only on screen, so the card stays about its illustration;
                            the name is "Conocer más" plus the capability. */}
                        <a class="bento-link" href={withBase(`/servicios/${service.slug}/`)}>
                            <span class="sr-only"><span data-i18n="services.more">Conocer más</span>: <span data-i18n={`srv.${service.id}.title`}>{service.title}</span></span>
                            <i data-lucide="arrow-up-right"></i>
                        </a>
                        <div class="bento-visual motion-lib-container" id={`motion-${service.id}`}>
                            <Visual />
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</section>
