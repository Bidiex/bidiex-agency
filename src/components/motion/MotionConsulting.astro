---
/**
 * Technical Consulting — an architecture audit: a scan line sweeps the layered
 * system, flags the two weak modules, and they resolve into checks while the
 * findings panel draws its trend.
 *
 * 520-wide canvas so the diagram fills a span-7 card.
 */
---
<svg class="motion-svg mv mv--consulting" viewBox="0 0 520 250"
     preserveAspectRatio="xMidYMax meet" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="mv-consulting-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.2" />
      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="mv-consulting-scan" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0" />
      <stop offset="70%" stop-color="var(--accent)" stop-opacity="0.09" />
      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.32" />
    </linearGradient>
    <clipPath id="mv-consulting-stack-clip">
      <rect x="24" y="28" width="318" height="212" rx="12" />
    </clipPath>
  </defs>

  <circle class="mv-a mv-glow" cx="260" cy="136" r="140" fill="url(#mv-consulting-glow)" />

  <!-- Layer stack -->
  <g transform="translate(30, 34)">
    <!-- Interlayer connectors -->
    <g stroke="rgba(255,255,255,0.12)" stroke-width="1" stroke-dasharray="3 4">
      <path d="M80 56 L80 72" />
      <path d="M190 56 L190 72" />
      <path d="M80 128 L80 144" />
      <path d="M210 128 L210 144" />
    </g>

    <!-- Presentation layer -->
    <g>
      <rect width="300" height="56" rx="10" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
      <rect x="16" y="15" width="72" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect x="98" y="15" width="72" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect x="180" y="15" width="104" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
    </g>

    <!-- Service layer -->
    <g transform="translate(0, 72)">
      <rect width="300" height="56" rx="10" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
      <rect x="16" y="15" width="56" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect x="82" y="15" width="56" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect x="148" y="15" width="56" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect x="214" y="15" width="70" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect class="mv-a mv-consulting__flag mv-consulting__flag--1" x="147" y="14" width="58" height="28" rx="7"
            fill="none" stroke="var(--accent)" stroke-width="1.5" />
    </g>

    <!-- Data layer -->
    <g transform="translate(0, 144)">
      <rect width="300" height="56" rx="10" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
      <rect x="16" y="15" width="124" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect x="150" y="15" width="134" height="26" rx="6" fill="rgba(255,255,255,0.06)" />
      <rect class="mv-a mv-consulting__flag mv-consulting__flag--2" x="149" y="14" width="136" height="28" rx="7"
            fill="none" stroke="var(--accent)" stroke-width="1.5" />
    </g>

    <!-- Resolutions -->
    <g transform="translate(205, 86)">
      <g class="mv-a mv-consulting__check mv-consulting__check--1">
        <circle r="9" fill="#0A0A0A" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1" />
        <path d="M-4 0 L-1.2 3 L4 -3" fill="none" stroke="var(--accent)" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
    <g transform="translate(285, 158)">
      <g class="mv-a mv-consulting__check mv-consulting__check--2">
        <circle r="9" fill="#0A0A0A" stroke="var(--accent)" stroke-opacity="0.5" stroke-width="1" />
        <path d="M-4 0 L-1.2 3 L4 -3" fill="none" stroke="var(--accent)" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  </g>

  <!-- Scanner -->
  <g clip-path="url(#mv-consulting-stack-clip)">
    <g class="mv-a mv-consulting__scan">
      <rect x="24" y="-48" width="318" height="48" fill="url(#mv-consulting-scan)" />
      <rect x="24" y="-1.5" width="318" height="1.5" fill="var(--accent)" fill-opacity="0.75" />
    </g>
  </g>

  <!-- Findings panel -->
  <g transform="translate(362, 34)">
    <rect width="130" height="200" rx="10" fill="#0A0A0A" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
    <rect x="16" y="18" width="64" height="6" rx="3" fill="rgba(255,255,255,0.18)" />
    <rect x="16" y="31" width="40" height="6" rx="3" fill="rgba(255,255,255,0.08)" />
    <path d="M16 52 L114 52" stroke="rgba(255,255,255,0.07)" stroke-width="1" />

    <path class="mv-a mv-consulting__trend" d="M16 120 L44 104 L68 110 L92 82 L114 62"
          fill="none" stroke="var(--accent)" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" />

    <g transform="translate(0, 182)">
      <rect class="mv-a mv-consulting__bar mv-consulting__bar--1" x="16" y="-46" width="22" height="46" rx="4" fill="rgba(255,255,255,0.14)" />
      <rect class="mv-a mv-consulting__bar mv-consulting__bar--2" x="48" y="-46" width="22" height="46" rx="4" fill="rgba(255,255,255,0.22)" />
      <rect class="mv-a mv-consulting__bar mv-consulting__bar--3" x="80" y="-46" width="22" height="46" rx="4" fill="var(--accent)" />
    </g>
  </g>
</svg>
