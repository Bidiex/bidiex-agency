---
/**
 * Automation — a workflow that runs itself: the trigger fires, packets travel
 * down both branches along the connectors, each node lights up as it executes
 * and confirms with a check before the output resolves.
 */
---
<svg class="motion-svg mv mv--auto" viewBox="0 0 400 250"
     preserveAspectRatio="xMidYMax meet" xmlns="http://www.w3.org/2000/svg"
     role="img" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="mv-auto-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.22" />
      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle class="mv-a mv-glow" cx="200" cy="128" r="110" fill="url(#mv-auto-glow)" />

  <!-- Connectors: a dim rail with an accent stroke drawn over it -->
  <g fill="none" stroke-width="1.5" stroke-linecap="round">
    <path d="M110 128 C140 128 138 68 168 68" stroke="rgba(255,255,255,0.10)" />
    <path d="M110 128 C140 128 138 188 168 188" stroke="rgba(255,255,255,0.10)" />
    <path d="M244 68 C274 68 272 128 302 128" stroke="rgba(255,255,255,0.10)" />
    <path d="M244 188 C274 188 272 128 302 128" stroke="rgba(255,255,255,0.10)" />

    <path class="mv-a mv-auto__flow mv-auto__flow--1" d="M110 128 C140 128 138 68 168 68" stroke="var(--accent)" />
    <path class="mv-a mv-auto__flow mv-auto__flow--2" d="M110 128 C140 128 138 188 168 188" stroke="var(--accent)" />
    <path class="mv-a mv-auto__flow mv-auto__flow--3" d="M244 68 C274 68 272 128 302 128" stroke="var(--accent)" />
    <path class="mv-a mv-auto__flow mv-auto__flow--4" d="M244 188 C274 188 272 128 302 128" stroke="var(--accent)" />
  </g>

  <!-- Packets travelling along the branches (positioned via offset-path) -->
  <g class="mv-auto__packets">
    <circle class="mv-a mv-auto__packet mv-auto__packet--1" r="4" fill="var(--accent)" />
    <circle class="mv-a mv-auto__packet mv-auto__packet--2" r="4" fill="var(--accent)" />
    <circle class="mv-a mv-auto__packet mv-auto__packet--3" r="4" fill="var(--accent-alt)" />
    <circle class="mv-a mv-auto__packet mv-auto__packet--4" r="4" fill="var(--accent-alt)" />
  </g>

  <!-- Trigger -->
  <g transform="translate(34, 106)">
    <rect width="76" height="44" rx="11" fill="#0A0A0A" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
    <rect class="mv-a mv-auto__ring mv-auto__ring--1" x="0.5" y="0.5" width="75" height="43" rx="10.5"
          fill="none" stroke="var(--accent)" stroke-width="1.5" />
    <path d="M22 13 L15 25 L21 25 L19 33 L27 21 L21 21 Z" fill="var(--accent)" fill-opacity="0.85" />
    <rect x="36" y="16" width="26" height="5" rx="2.5" fill="rgba(255,255,255,0.20)" />
    <rect x="36" y="26" width="18" height="5" rx="2.5" fill="rgba(255,255,255,0.09)" />
  </g>

  <!-- Branch A -->
  <g transform="translate(168, 46)">
    <rect width="76" height="44" rx="11" fill="#0A0A0A" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
    <rect class="mv-a mv-auto__ring mv-auto__ring--2" x="0.5" y="0.5" width="75" height="43" rx="10.5"
          fill="none" stroke="var(--accent)" stroke-width="1.5" />
    <rect x="14" y="15" width="14" height="14" rx="4" fill="rgba(255,255,255,0.10)" />
    <rect x="36" y="16" width="26" height="5" rx="2.5" fill="rgba(255,255,255,0.20)" />
    <rect x="36" y="26" width="16" height="5" rx="2.5" fill="rgba(255,255,255,0.09)" />
    <g transform="translate(62, -6)">
      <g class="mv-a mv-auto__check mv-auto__check--2">
        <circle r="8" fill="#0A0A0A" stroke="var(--accent)" stroke-opacity="0.45" stroke-width="1" />
        <path d="M-3.5 0 L-1 2.6 L3.5 -2.6" fill="none" stroke="var(--accent)" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  </g>

  <!-- Branch B -->
  <g transform="translate(168, 166)">
    <rect width="76" height="44" rx="11" fill="#0A0A0A" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
    <rect class="mv-a mv-auto__ring mv-auto__ring--3" x="0.5" y="0.5" width="75" height="43" rx="10.5"
          fill="none" stroke="var(--accent)" stroke-width="1.5" />
    <circle cx="21" cy="22" r="7" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.5" />
    <rect x="36" y="16" width="22" height="5" rx="2.5" fill="rgba(255,255,255,0.20)" />
    <rect x="36" y="26" width="26" height="5" rx="2.5" fill="rgba(255,255,255,0.09)" />
    <g transform="translate(62, -6)">
      <g class="mv-a mv-auto__check mv-auto__check--3">
        <circle r="8" fill="#0A0A0A" stroke="var(--accent)" stroke-opacity="0.45" stroke-width="1" />
        <path d="M-3.5 0 L-1 2.6 L3.5 -2.6" fill="none" stroke="var(--accent)" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  </g>

  <!-- Output -->
  <g transform="translate(302, 106)">
    <rect width="64" height="44" rx="11" fill="#0A0A0A" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
    <rect class="mv-a mv-auto__ring mv-auto__ring--4" x="0.5" y="0.5" width="63" height="43" rx="10.5"
          fill="none" stroke="var(--accent)" stroke-width="1.5" />
    <path class="mv-a mv-auto__done" d="M20 22.5 L27 29.5 L44 13"
          fill="none" stroke="var(--accent)" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
