---
import { projects } from '../data/projects.js';
import { withBase } from '../utils/url.js';
import ProjectModal from './ProjectModal.astro';

/** Bare host shown in the fake address bar, e.g. "www.traego.app". */
const hostOf = (url) => {
  try { return new URL(url).host; } catch { return ''; }
};
---
<section class="projects" id="projects">
  <div class="container">

    <div class="projects-header reveal">
      <div>
        <h2 class="section-title gradient-text" data-i18n="projects.title">Nuestros Proyectos</h2>
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn" id="projectsPrev" aria-label="Anterior"><i data-lucide="arrow-left"></i></button>
        <button class="carousel-btn" id="projectsNext" aria-label="Siguiente"><i data-lucide="arrow-right"></i></button>
      </div>
    </div>

    <div class="projects-track-wrapper">
      <div class="projects-track" id="projectsCarousel">
        {projects.map((project) => (
          <article class="project-card premium-card" data-project={project.id} tabindex="0" role="button"
                   aria-label={`Ver detalles de ${project.name}`}>
            <div class="project-card__glow"></div>
            <div class="project-card__visual">
              {project.preview && (
                <div class="browser-frame">
                  <div class="browser-frame__bar">
                    <span class="browser-frame__dots" aria-hidden="true">
                      <i></i><i></i><i></i>
                    </span>
                    {project.url && <span class="browser-frame__url">{hostOf(project.url)}</span>}
                  </div>
                  <div class="browser-frame__viewport">
                    {project.preview.type === 'embed' ? (
                      /* aria-hidden + tabindex -1: the embed is decoration, and the
                         card itself is the interactive element. Clicks fall through
                         to the card because CSS disables pointer events on it. */
                      <iframe
                        class="browser-frame__embed"
                        src={project.preview.src}
                        title={`Vista previa de ${project.name}`}
                        loading="lazy"
                        tabindex="-1"
                        aria-hidden="true"
                        scrolling="no"
                        referrerpolicy="no-referrer"
                        sandbox="allow-scripts allow-same-origin"
                      ></iframe>
                    ) : (
                      <img class="browser-frame__shot" src={withBase(project.preview.src)} alt={project.name} loading="lazy" />
                    )}
                  </div>
                </div>
              )}
              <div class="project-card__overlay"></div>
            </div>
            <div class="project-card__content">
              <div class="project-card__header">
                <div class="project-card__meta-top">
                  <span class={`premium-badge status-${project.status}`}>
                    <span class="pulse-dot"></span>
                    <span data-i18n={`status.${project.status}`}>{project.statusLabel}</span>
                  </span>
                </div>
                <h3 class="project-card__name">{project.name}</h3>
                <p class="project-card__tagline" data-i18n={`project.${project.id}.tagline`}>
                  {project.tagline}
                </p>
              </div>
              <div class="project-card__tech">
                {project.tech.map((tech) => <span class="tech-pill">{tech}</span>)}
              </div>
              <div class="project-card__meta-bottom">
                {project.meta[0]} <span class="meta-dot">•</span> {project.meta[1]} <span class="meta-dot">•</span> {project.meta[2]}
              </div>
              <span class="project-card__cta"><span data-i18n="project.view">Ver proyecto</span> <i data-lucide="arrow-right" class="icon-sm"></i></span>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<ProjectModal />
