                <LangToggle />
            </li>
        </ul>

        <div class="nav-right">
            <LangToggle class="desktop-lang" />
            <a href="#contact" class="btn btn-primary nav-cta"><img src="https://cdn.simpleicons.org/whatsapp/black" style="width: 1.2em; height: 1.2em; vertical-align: text-bottom;" alt=""> <span data-i18n="nav.cta">Iniciar Proyecto</span></a>
