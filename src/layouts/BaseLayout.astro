---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url.js';
import '../styles/global.css';

const {
    title = 'Bidiex — Software Studio',
    description = 'Bidiex es un estudio independiente de productos digitales enfocado en crear software, automatizaciones, experiencias digitales y herramientas escalables para emprendedores y empresas.',
    noindex = false,
    // i18n key that swaps the tab title along with the page language.
    titleKey = undefined,
} = Astro.props;

// Derived from `site` + `base` in astro.config.mjs so the canonical, og:url and
// og:image always point at wherever the build is actually published.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('og-image.jpg'), Astro.site).href;
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Core SEO -->
    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="software studio, estudio de software, digital product, desarrollo web, automatización, Bidiex">
    <link rel="canonical" href={canonical}>
    {noindex && <meta name="robots" content="noindex">}

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content="website">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>

    <!-- PWA & Icons -->
    <meta name="theme-color" content="#050608">
    <link rel="manifest" href={withBase('site.webmanifest')}>
    <link rel="icon" type="image/webp" href={withBase('favicon.webp')}>
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32x32.png')}>
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')}>

    <!-- Typography -->
    <link rel="preload" href={withBase('fonts/Ranade-Variable.woff2')} as="font" type="font/woff2" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Scroll Progress -->
    <div class="scroll-progress" id="scrollProgress"></div>

    <!-- Loading Animation -->
