        </svg>
    </div>

    <!-- Background Layers -->
    <div class="bg-layers" aria-hidden="true" id="parallaxBg">
        <div class="bg-glow blue-glow"></div>
        <div class="bg-glow purple-glow"></div>
        <div class="bg-noise"></div>
    </div>

    <Navbar />

    <main>
        <slot />
    </main>

    <Footer />

    <!-- Back to Top Button -->
    <button id="backToTop" class="back-to-top ripple" data-i18n-aria="btn.totop" aria-label="Volver arriba">
        <i data-lucide="arrow-up"></i>
    </button>

    <!-- Lucide replaces every [data-lucide] placeholder with its inline SVG. -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script is:inline>
      lucide.createIcons();
    </script>
    <script>
      import '../scripts/main.js';
    </script>
</body>
</html>
