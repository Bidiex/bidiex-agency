---
/**
 * Link-in-bio page for Álvaro's personal Instagram — the place he promotes
 * the agency from. Deliberately off-brand: it skips BaseLayout (no navbar,
 * footer or site motion) and takes an Apple look instead — system type,
 * a grouped inset list like iOS Settings, project cards below it. Always
 * light: it is opened from browsers set to dark, and should look the same.
 *
 * External links carry utm_* so traffic from the bio is tellable apart.
 */
import { withBase } from '../utils/url.js';

const utm = 'utm_source=instagram&utm_medium=bio&utm_campaign=alvarodevalba';
const whatsapp = `https://wa.me/573156290330?text=${encodeURIComponent('Hola Álvaro, vengo de tu Instagram 👋')}`;

const projects = [
    { name: 'TraeGo', url: 'https://www.traego.app/', img: 'traego.webp', desc: 'Pedidos directos para restaurantes, sin comisiones de apps.' },
    { name: 'Invio', url: 'https://invio-invitaciones-digitales.vercel.app/', img: 'invio.jpg', desc: 'Invitaciones digitales con confirmación de asistencia.' },
];

const canonical =new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('Photo founder.webp'), Astro.site).href;
const title = 'Álvaro de Alba — Bidiex';
const description = 'Fundador de Bidiex. Software, automatizaciones y productos digitales. Escríbeme o conoce nuestros proyectos.';
---
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content="profile">
    <meta name="twitter:card" content="summary">

    <meta name="theme-color" content="#f5f5f7">
    <meta name="color-scheme" content="light only">
    <link rel="icon" type="image/webp" href={withBase('favicon.webp')}>
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')}>
</head>
<body>
    <main class="bio">
        <header class="bio__head">
            <img class="bio__avatar" src={withBase('Photo founder.webp')} alt="Álvaro de Alba" width="104" height="104">
            <h1 class="bio__name">Álvaro de Alba</h1>
            <p class="bio__role">Fundador de <a href={`${withBase('/')}?${utm}`}>Bidiex</a></p>
            <p class="bio__lead">Diseño y construyo software, automatizaciones y productos digitales.</p>
            <a class="bio__cta" href={whatsapp} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43a9.37 9.37 0 0 1 9.42 9.44c0 5.2-4.23 9.43-9.43 9.43m8.03-17.46A11.3 11.3 0 0 0 12.05.71C5.8.71.7 5.8.7 12.06c0 2 .52 3.95 1.52 5.67L.6 23.29l5.7-1.5a11.3 11.3 0 0 0 5.43 1.39h.01c6.25 0 11.35-5.09 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02"/></svg>
                Escríbeme por WhatsApp
            </a>
        </header>

        <ul class="list">
            <li>
                <a class="row" href={`${withBase('/')}?${utm}`}>
                    <span class="row__icon row__icon--img"><img src={withBase('bidiex-logo.webp')} alt="" width="30" height="30"></span>
                    <span class="row__text">
                        <span class="row__title">Bidiex Software Studio</span>
                        <span class="row__sub">Servicios, proyectos y forma de trabajo</span>
                    </span>
                    <span class="row__chev" aria-hidden="true"></span>
                </a>
            </li>
            <li>
                <a class="row" href={`${withBase('/')}?${utm}#contact`}>
                    <span class="row__icon row__icon--brief" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 7h6m-6 4h4"/></svg>
                    </span>
                    <span class="row__text">
                        <span class="row__title">Cuéntame tu proyecto</span>
                        <span class="row__sub">Un brief corto y te respondo por WhatsApp</span>
                    </span>
                    <span class="row__chev" aria-hidden="true"></span>
                </a>
            </li>
        </ul>

        {projects.map((p) => (
            <a class="feature" href={`${p.url}?${utm}`} target="_blank" rel="noopener">
                <img class="feature__img" src={withBase(p.img)} alt={`Captura de ${p.name}`} width="800" height="500">
                <span class="feature__body">
                    <span class="feature__text">
                        <span class="row__title">{p.name}</span>
                        <span class="row__sub">{p.desc}</span>
                    </span>
                    <span class="feature__go">Abrir</span>
                </span>
            </a>
        ))}

        <footer class="bio__foot">
            <a href={`${withBase('/')}?${utm}`}>Bidiex</a> · Software Studio · {new Date().getFullYear()}
        </footer>
    </main>

    <style is:global>
        :root {
            --bg: #f5f5f7;
            --card: #ffffff;
            --text: #1d1d1f;
            --muted: #6e6e73;
            --sep: rgba(60, 60, 67, 0.14);
            --accent: #0071e3;
            --press: rgba(0, 0, 0, 0.05);
            --shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 24px rgba(0, 0, 0, 0.05);
            color-scheme: light;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; }
        body {
            margin: 0;
            min-height: 100vh;
            background-color: var(--bg);
            background-image:
                radial-gradient(120% 60% at 50% 0%, rgba(214, 228, 255, 0.55), transparent 70%),
                radial-gradient(90% 50% at 100% 100%, rgba(255, 226, 236, 0.4), transparent 70%),
                linear-gradient(180deg, #fbfbfd 0%, #f5f5f7 100%);
            background-attachment: fixed;
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Inter", "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 17px;
            line-height: 1.47;
            letter-spacing: -0.022em;
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
        }
        a { color: inherit; text-decoration: none; }

        .bio {
            max-width: 460px;
            margin: 0 auto;
            padding: max(48px, env(safe-area-inset-top)) 16px max(32px, env(safe-area-inset-bottom));
        }

        .bio__head { text-align: center; margin-bottom: 36px; }
        .bio__avatar {
            width: 104px; height: 104px;
            border-radius: 50%;
            object-fit: cover;
            display: block;
            margin: 0 auto 16px;
            box-shadow: 0 0 0 4px var(--card), 0 6px 20px rgba(0, 0, 0, 0.12);
        }
        .bio__name {
            margin: 0;
            font-size: 32px;
            line-height: 1.12;
            font-weight: 700;
            letter-spacing: -0.03em;
        }
        .bio__role { margin: 6px 0 0; color: var(--muted); font-size: 17px; }
        .bio__role a { color: var(--accent); }
        .bio__lead {
            margin: 12px auto 0;
            max-width: 32ch;
            font-size: 15px;
            color: var(--muted);
            letter-spacing: -0.01em;
        }
        .bio__cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 22px;
            padding: 12px 22px;
            border-radius: 980px;
            background: var(--accent);
            color: #fff;
            font-size: 17px;
            font-weight: 500;
            transition: transform 0.2s ease, filter 0.2s ease;
        }
        .bio__cta svg { width: 20px; height: 20px; }
        .bio__cta:hover { filter: brightness(1.08); }
        .bio__cta:active { transform: scale(0.97); }

        .list {
            list-style: none;
            margin: 0;
            padding: 0;
            background: var(--card);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }
        .list li + li .row__text { border-top: 0.5px solid var(--sep); }

        .row {
            display: flex;
            align-items: stretch;
            padding-left: 16px;
            transition: background-color 0.15s ease;
        }
        .row:hover, .row:active { background: var(--press); }
        .row__icon {
            flex: none;
            align-self: center;
            margin-right: 14px;
            width: 36px; height: 36px;
            border-radius: 9px;
            display: grid;
            place-items: center;
            color: #fff;
        }
        .row__icon svg { width: 22px; height: 22px; }
        .row__icon--img { background: #050608; overflow: hidden; }
        .row__icon--img img { width: 30px; height: 30px; object-fit: contain; }
        .row__icon--brief { background: linear-gradient(180deg, #5ac8fa, #0a84ff); }
        .row__text {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 12px 0;
        }
        .row__title { font-size: 17px; font-weight: 500; line-height: 1.3; }
        .row__sub {
            font-size: 14px;
            line-height: 1.35;
            color: var(--muted);
            letter-spacing: -0.01em;
        }
        .row__chev {
            flex: none;
            width: 32px;
            display: grid;
            place-items: center;
        }
        .list li + li .row__chev { border-top: 0.5px solid var(--sep); }
        .row__chev::after {
            content: "";
            width: 8px; height: 8px;
            border-top: 2px solid var(--muted);
            border-right: 2px solid var(--muted);
            transform: rotate(45deg);
            opacity: 0.55;
            margin-right: 6px;
        }

        .feature {
            display: block;
            margin-bottom: 20px;
            background: var(--card);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
        }
        .feature:hover { transform: scale(1.012); }
        .feature:active { transform: scale(0.99); }
        .feature__img {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 16 / 10;
            object-fit: cover;
            object-position: top;
        }
        .feature__body {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px 16px;
        }
        .feature__text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .feature__text .row__title { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; }
        .feature__go {
            flex: none;
            padding: 6px 16px;
            border-radius: 980px;
            background: var(--bg);
            color: var(--accent);
            font-size: 15px;
            font-weight: 600;
        }

        .bio__foot {
            margin-top: 36px;
            text-align: center;
            font-size: 12px;
            color: var(--muted);
        }
        .bio__foot a { color: var(--accent); }

        a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 12px; }
        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; }
        }
    </style>
</body>
</html>
