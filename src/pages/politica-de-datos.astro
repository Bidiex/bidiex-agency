---
/**
 * Personal Data Processing Policy — the page the contact form's consent
 * checkbox points to. Copy lives in src/data/privacy.js, in both languages;
 * every node carries a legal.* key so the language toggle swaps the page.
 *
 * Laid out like Invio's terms page, the house pattern for legal text: one
 * narrow reading column, a title with its update date and a short intro, an
 * index of anchors, then numbered sections divided by rules.
 *
 * The contact form is rendered at the foot, as on the service pages, so the
 * navbar's "#contact" CTA keeps working here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { policy } from '../data/privacy.js';
import { withBase } from '../utils/url.js';

const doc = policy.es;
---
<BaseLayout title={doc.doctitle} titleKey="legal.doctitle" description={doc.lead}>
    <div class="container legal">
        <header class="legal__hero">
            <a class="srv-back" href={withBase('/')}>
                <i data-lucide="arrow-left"></i>
                <span data-i18n="legal.back">{doc.back}</span>
            </a>
            <h1 class="legal__title gradient-text" data-i18n="legal.title">{doc.title}</h1>
            <p class="legal__meta">
                <time datetime={policy.updated} data-i18n="legal.updated">{doc.updated}</time>
            </p>
            <p class="legal__meta legal__note" data-i18n="legal.note">{policy.en.note}</p>
            <p class="legal__intro" data-i18n="legal.intro">{doc.intro}</p>
        </header>

        <nav class="legal__index" aria-labelledby="legal-index-title">
            <h2 class="legal__index-title" id="legal-index-title" data-i18n="legal.index">{doc.index}</h2>
            <ol>
                {doc.sections.map((s, i) => (
                    <li><a href={`#${s.id}`} data-i18n={`legal.s${i}.title`}>{s.title}</a></li>
                ))}
            </ol>
        </nav>

        {doc.sections.map((s, i) => (
            <article class="legal__section" id={s.id}>
                <h2>
                    <span class="legal__num">{i + 1}.</span>
                    <span data-i18n={`legal.s${i}.title`}>{s.title}</span>
                </h2>
                {(s.body ?? []).map((p, j) => <p data-i18n={`legal.s${i}.p${j}`}>{p}</p>)}
                {s.list && (
                    <ul>
                        {s.list.map((l, j) => <li data-i18n={`legal.s${i}.l${j}`}>{l}</li>)}
                    </ul>
                )}
                {(s.after ?? []).map((p, j) => <p data-i18n={`legal.s${i}.a${j}`}>{p}</p>)}
            </article>
        ))}
    </div>

    <Contact />
</BaseLayout>
