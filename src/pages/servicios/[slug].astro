---
/**
 * One page per capability, generated from src/data/services.js.
 *
 * The page is a sales argument read top to bottom: a claim (hero), the
 * reader's own problems (pains), how we solve them (approach), what they
 * receive (offer), proof that we have done it (cases), how it runs (process),
 * when not to hire us (not fit) and the questions left before writing (faq).
 * The contact form is rendered here too, so "#contact" never leaves the page.
 *
 * Section titles sit in a left column beside their content on wide screens,
 * the same editorial split as the projects showcase, instead of a centred
 * heading over a grid of cards.
 *
 * Every string carries a data-i18n key derived from the same data, so the
 * language toggle swaps the whole page. Cases reuse the project dialog: any
 * [data-project] button opens it through the Projects module in main.js.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import { visuals } from '../../components/motion/index.js';
import { services } from '../../data/services.js';
import { projectsById } from '../../data/projects.js';
import { withBase } from '../../utils/url.js';

export function getStaticPaths() {
    return services.map((service) => ({
        params: { slug: service.slug },
        props: { service },
    }));
}

const { service } = Astro.props;
const page = service.page.es;
const k = `srvp.${service.id}`;
const Visual = visuals[service.id];
const cases = service.projects.map((id) => projectsById[id]).filter(Boolean);
const others = services.filter((s) => s.id !== service.id);
const pad = (i) => String(i + 1).padStart(2, '0');
---
<BaseLayout
    title={`${service.title} — Bidiex`}
    titleKey={`${k}.doctitle`}
    description={page.lead}
>
    <section class="srv-hero">
        <div class="container srv-hero__grid">
            <div class="srv-hero__copy">
                <a class="srv-back" href={withBase('/#services')}>
                    <i data-lucide="arrow-left"></i>
                    <span data-i18n="srvpage.back">Todas las capacidades</span>
                </a>

                <p class="srv-eyebrow">
                    <i data-lucide={service.icon}></i>
                    <span data-i18n={`srv.${service.id}.title`}>{service.title}</span>
                </p>

                <h1 class="gradient-text" data-motion="heading" data-i18n={`${k}.headline`}>{page.headline}</h1>
                <p class="srv-hero__lead reveal" data-i18n={`${k}.lead`}>{page.lead}</p>

                <div class="hero-actions srv-hero__actions reveal">
                    <a href="#contact" class="btn btn-primary ripple">
                        <span data-i18n="hero.ctaSecondary">Contáctanos</span>
                        <i data-lucide="arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="srv-hero__visual reveal" aria-hidden="true">
                <div class="motion-lib-container" id={`motion-${service.id}`}>
                    <Visual />
                </div>
            </div>
        </div>
    </section>

    <section class="srv-section">
        <div class="container srv-split">
            <h2 class="srv-label gradient-text" data-motion="heading" data-i18n="srvpage.pains">¿Te suena?</h2>
            <ol class="srv-pains">
                {page.pains.map((pain, i) => (
                    <li class="reveal">
                        <span class="srv-index">{pad(i)}</span>
                        <p data-i18n={`${k}.pain${i}`}>{pain}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="srv-section">
        <div class="container srv-split">
            <h2 class="srv-label gradient-text" data-motion="heading" data-i18n="srvpage.approach">Cómo lo resolvemos</h2>
            <div class="srv-body">
                {page.approach.map((paragraph, i) => (
                    <p data-motion="words" data-i18n={`${k}.approach${i}`}>{paragraph}</p>
                ))}
            </div>
        </div>
    </section>

    <section class="srv-section">
        <div class="container srv-split">
            <h2 class="srv-label gradient-text" data-motion="heading" data-i18n="srvpage.what">Qué te entregamos</h2>
            <ul class="srv-offer">
                {page.offer.map((item, i) => (
                    <li class="srv-offer__row reveal">
                        <span class="srv-index">{pad(i)}</span>
                        <h3 data-i18n={`${k}.offer${i}.title`}>{item.title}</h3>
                        <p data-i18n={`${k}.offer${i}.desc`}>{item.desc}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    {cases.length > 0 && (
        <section class="srv-section">
            <div class="container srv-split">
                <h2 class="srv-label gradient-text" data-motion="heading" data-i18n="srvpage.cases">Lo hemos hecho antes</h2>
                <div class="srv-cases">
                    {cases.map((project) => (
                        <article class="srv-case reveal">
                            <header class="srv-case__head">
                                <h3 class="srv-case__name gradient-text">{project.name}</h3>
                                <span class={`showcase__status status-${project.status}`}>
                                    <span class="pulse-dot"></span>
                                    <span data-i18n={`status.${project.status}`}>{project.statusLabel}</span>
                                </span>
                            </header>
                            <p class="srv-case__tagline" data-i18n={`project.${project.id}.tagline`}>{project.tagline}</p>
                            <p class="srv-case__problem" data-i18n={`project.${project.id}.problem`}>{project.problem}</p>
                            <ul class="srv-case__outcome">
                                {project.outcome.slice(0, 2).map((line, i) => (
                                    <li data-i18n={`project.${project.id}.outcome${i}`}>{line}</li>
                                ))}
                            </ul>
                            <footer class="srv-case__foot">
                                <div class="srv-case__tech">
                                    {project.tech.map((tech) => <span class="tech-pill">{tech}</span>)}
                                </div>
                                <button type="button" class="srv-case__cta" data-project={project.id}>
                                    <span data-i18n="srvpage.caseCta">Ver el caso</span>
                                    <span class="sr-only">{project.name}</span>
                                    <i data-lucide="arrow-up-right"></i>
                                </button>
                            </footer>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )}

    <section class="srv-section">
        <div class="container">
            <h2 class="srv-heading gradient-text" data-motion="heading" data-i18n="srvpage.how">Paso a paso</h2>
            <ol class="srv-steps">
                {page.process.map((step, i) => (
                    <li class="srv-steps__item reveal">
                        <span class="srv-steps__marker">{i + 1}</span>
                        <h3 data-i18n={`${k}.step${i}.title`}>{step.title}</h3>
                        <p data-i18n={`${k}.step${i}.desc`}>{step.desc}</p>
                        <p class="srv-steps__output">
                            <span data-i18n="srvpage.output">Entregable</span>
                            <strong data-i18n={`${k}.step${i}.output`}>{step.output}</strong>
                        </p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="srv-section">
        <div class="container srv-split">
            <h2 class="srv-label gradient-text" data-motion="heading" data-i18n="srvpage.notfit">Mejor no, si…</h2>
            <ul class="srv-notfit">
                {page.notFit.map((line, i) => (
                    <li class="reveal" data-i18n={`${k}.notfit${i}`}>{line}</li>
                ))}
            </ul>
        </div>
    </section>

    <section class="srv-section">
        <div class="container srv-split">
            <h2 class="srv-label gradient-text" data-motion="heading" data-i18n="srvpage.faq">Preguntas frecuentes</h2>
            <div class="srv-faq">
                {page.faq.map((item, i) => (
                    <details class="srv-faq__item reveal">
                        <summary>
                            <span data-i18n={`${k}.faq${i}.q`}>{item.q}</span>
                            <i data-lucide="plus"></i>
                        </summary>
                        <p data-i18n={`${k}.faq${i}.a`}>{item.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="srv-section srv-closing">
        <div class="container">
            <p class="srv-closing__text gradient-text" data-motion="heading" data-i18n="srvpage.closing">
                Cuéntanos en qué punto estás y qué quieres lograr. Con eso basta para empezar.
            </p>
            <a href="#contact" class="btn btn-primary ripple">
                <span data-i18n="hero.ctaSecondary">Contáctanos</span>
                <i data-lucide="arrow-right"></i>
            </a>
        </div>
    </section>

    <section class="srv-section">
        <div class="container">
            <h2 class="srv-others__title" data-i18n="srvpage.others">Otras capacidades</h2>
            <ul class="srv-others">
                {others.map((other) => (
                    <li>
                        <a href={withBase(`/servicios/${other.slug}/`)}>
                            <i data-lucide={other.icon}></i>
                            <span data-i18n={`srv.${other.id}.title`}>{other.title}</span>
                            <i data-lucide="arrow-up-right" class="srv-others__arrow"></i>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <Contact />
    {cases.length > 0 && <ProjectModal />}
</BaseLayout>
